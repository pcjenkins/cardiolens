{
  "name": "cardiolens",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run test:report",
    "build": "next build",
    "start": "next start",
    "seed": "node scripts/seed.mjs",
    "test": "jest",
    "test:report": "jest --json --outputFile=data/release/test-results.json --coverage --coverageReporters=json-summary --coverageDirectory=data/release/coverage",	
    "setup": "npm install && npm run seed && npm run build"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.12",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.13"
  }
}
