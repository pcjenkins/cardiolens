{
  "name": "cardiolens",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "postinstall": "npm --prefix api install --no-audit --no-fund",
    "dev": "next dev",
    "api": "npm --prefix api run dev",
    "stack": "concurrently -k -n api,web -c blue,green \"npm:api\" \"npm:dev\"",
    "db:reset": "npm --prefix api run db:reset",
    "db:restore": "npm --prefix api run db:restore",
    "env:init": "npm --prefix api run env:init",
    "prebuild": "npm run test:report",
    "build": "next build",
    "start": "next start",
    "start:stack": "concurrently -k -n api,web -c blue,green \"npm --prefix api start\" \"npm:start\"",
    "test": "jest",
    "test:api": "npm --prefix api test",
    "test:all": "npm run test:api && npm test",
    "test:report": "jest --json --outputFile=data/release/test-results.json --coverage --coverageReporters=json-summary --coverageDirectory=data/release/coverage",
    "setup": "npm install && npm run db:reset && npm run build"
  },
  "dependencies": {
    "jose": "^6.2.12",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "typescript": "^5.9.3",
    "concurrently": "^10.0.6"
  },
  "engines": {
    "node": ">=22.13"
  }
}
