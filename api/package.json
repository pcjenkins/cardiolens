{
  "name": "cardiolens-api",
  "version": "0.2.0",
  "private": true,
  "description": "CardioLens data service: Express + Apollo GraphQL over PostgreSQL",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "db:reset": "tsx scripts/reset.ts",
    "db:restore": "tsx scripts/restore.ts",
    "env:init": "tsx scripts/init-env.ts",
    "test": "node --import tsx --test --test-reporter=spec test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "bcryptjs": "^3.0.3",
    "dataloader": "^2.2.3",
    "express": "^5.1.0",
    "graphql": "^16.14.2",
    "jose": "^6.2.12",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.13"
  }
}
